# ----------------------------------------------------------------------------
# SmartCanteen environment configuration (EXAMPLE)
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` — it is git-ignored. Credentials must not be
# hard-coded anywhere in source.
# ----------------------------------------------------------------------------

# --- MySQL (primary, source of truth) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=smartcanteen_app
MYSQL_PASSWORD=change_me_app_password
MYSQL_DATABASE=smartcanteen
# Connection pool size
MYSQL_POOL_LIMIT=10

# Admin credentials used ONLY by scripts/db-setup.mjs to create the schema
# (leave blank to be prompted / use your own root). Do not use these at runtime.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=your_mysql_root_password

# --- MongoDB (activity logs + feedback analytics) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=smartcanteen

# --- Auth / session ---
# 32+ char random string used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_secret
# Cookie max age in seconds (default 7 days)
SESSION_MAX_AGE=604800

# --- App ---
NODE_ENV=development
